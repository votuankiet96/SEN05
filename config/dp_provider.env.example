# SEN05 DP Program - operator configuration.
# Copy to config/dp_provider.env, fill credentials, then run:
#   python -m core_engine doctor
# before starting the supervisor with `python -m core_engine run`.
#
# Everything in this file is operator-editable runtime configuration
# (core_engine.settings.operational). Fixed, code-level domain tables
# (timeframe maps, default bar counts) are not here - they live in
# core_engine/settings/system.py and do not vary by deployment.

# ---------------------------------------------------------------------------
# App root override (optional)
# ---------------------------------------------------------------------------
# Uncomment to force the repository root DP Program reads config/ and writes
# runtime/ under, instead of auto-detecting it from the installed package
# location. Leave unset for a normal single-checkout deployment.
# DP_APP_ROOT=C:\Share\dp_program

# ---------------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------------
SQL_SERVER=localhost
SQL_DATABASE=SEN05_AutoTrading
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_PORT=
SQL_TDS_VERSION=7.4
SQL_UID=
SQL_PWD=
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERT=yes
SQL_HEALTH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# TradingView
# ---------------------------------------------------------------------------
TV_AUTH_TOKEN=
TV_COOKIE=
TV_USERNAME=
TV_PASSWORD=
TV_2FA_SECRET=
TV_CAPTCHA_API_KEY=
TV_CAPTCHA_SERVICE=capsolver
TV_AUTH_HEADLESS_FRESH_LOGIN=0
TV_BROWSER_PROFILE_DIR=
TV_TOKEN_PROACTIVE_REFRESH_SEC=900
TV_TOKEN_PROACTIVE_RETRY_SEC=600
TV_AUTH_REFRESH_COOLDOWN_SEC=900
TV_AUTH_TRANSIENT_COOLDOWN_SEC=300
TV_AUTH_CONNECTIVITY_PREFLIGHT=1
TV_AUTH_CONNECTIVITY_CONNECT_TIMEOUT_SEC=2
TV_AUTH_CONNECTIVITY_READ_TIMEOUT_SEC=4
TV_AUTH_REFRESH_LOCK_STALE_SEC=1200
PLAYWRIGHT_CHROMIUM_INSTALL_TIMEOUT_SECONDS=1800

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_SEND_ATTEMPTS=2
DISCORD_TIMEOUT_CONNECT_SEC=2
DISCORD_TIMEOUT_READ_SEC=4
DISCORD_CIRCUIT_FAILURES=3
DISCORD_CIRCUIT_COOLDOWN_SEC=300
DISCORD_DEDUPE_WINDOW_SEC=600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backend terminal supervisor
# ---------------------------------------------------------------------------
BACKEND_HEALTH_INTERVAL_SEC=30
BACKEND_LIVE_RESTART_ON_EXIT=1
BACKEND_LIVE_RESTART_ON_STALE=1
BACKEND_LIVE_STALE_MINUTES=15
BACKEND_LIVE_MAX_RESTARTS_PER_HOUR=3
BACKEND_LIVE_RESTART_COOLDOWN_SEC=60
BACKEND_SHUTDOWN_GRACE_SEC=240
BACKEND_LOG_RETENTION_DAYS=30
BACKEND_STATUS_JSON_INDENT=2

# ---------------------------------------------------------------------------
# Historical pipeline
# ---------------------------------------------------------------------------
HISTORICAL_PROVIDER=websocket
HISTORICAL_BACKFILL_ENABLED=1
HISTORICAL_BACKFILL_UTC=11:00,22:00
HISTORICAL_START_ON_BACKEND_START=1
HISTORICAL_START_DELAY_SEC=15
HISTORICAL_BACKFILL_MODE=gap
HISTORICAL_BACKFILL_ARGS=
HISTORICAL_MAX_RUNTIME_MINUTES=360
BACKEND_HISTORICAL_RETRY_BASE_SEC=300
BACKEND_HISTORICAL_RETRY_MAX_SEC=1800
STAGING_INSERT_CHUNK_ROWS=50000
STAGING_CLEANUP_BATCH_ROWS=5000
STAGING_CLEANUP_PAUSE_SEC=0.05
STAGING_CLEANUP_MAX_ROWS_PER_RUN=500000
STAGING_CLEANUP_CHECKPOINT=1
HISTORICAL_DROP_OPEN_LAST_BAR=1
N_BARS_W=1000
N_BARS_D1=5000
N_BARS_H8=10000
N_BARS_H6=10000
N_BARS_H4=10000
N_BARS_H3=10000
N_BARS_H2=10000
N_BARS_H1=20000
N_BARS_M90=10000
N_BARS_M45=10000
N_BARS_M30=20000
N_BARS_M20=20000
N_BARS_M15=20000
N_BARS_M10=20000
N_BARS_M5=20000

TV_WS_HISTORY_ENDPOINT=prodata
TV_WS_HISTORY_FALLBACK_ENDPOINTS=data
TV_WS_HISTORY_TIMEOUT_SEC=45
TV_WS_HISTORY_REQUEST_MORE_ROUNDS=5
TV_WS_HISTORY_REQUEST_MORE_BARS=50000

TV_WS_REPLAY_ENABLED=1
TV_WS_REPLAY_TFS=M5,M10,M15,M20,M30,M45,H1
TV_WS_REPLAY_ENDPOINT=prodata
TV_WS_REPLAY_START_DATE=1970-01-01
TV_WS_REPLAY_WINDOW_BARS=5000
TV_WS_REPLAY_STEP_BARS=5000
TV_WS_REPLAY_MAX_WINDOWS_PER_PAIR=1000
TV_WS_REPLAY_ADVANCE_FACTOR=1.25
TV_WS_REPLAY_TIMEOUT_SEC=30

PIPELINE_SAFETY_FACTOR=1.5
PIPELINE_MIN_PULL_BARS=10
PIPELINE_RETRY_DELAYS=10,30,60
PIPELINE_SLEEP_GOLD_SEC=10
PIPELINE_SLEEP_NORMAL_SEC=5
PIPELINE_FILL_THRESHOLD=5
PIPELINE_HOLE_LOOKBACK_DAYS=60
PIPELINE_MAX_CONSECUTIVE_FAIL=8
PIPELINE_PREFLIGHT_SYMBOLS=US500,EURUSD,BTCUSD,FR40
PIPELINE_PREFLIGHT_SYMBOL_LIMIT=4
PIPELINE_PREFLIGHT_BARS=5
PIPELINE_PREFLIGHT_RETRIES=1
PIPELINE_PREFLIGHT_TIMEOUT_SEC=30
DP_HISTORICAL_CANCEL_FILE=
PIPELINE_OVERNIGHT_GAP_INDICE=1080
PIPELINE_OVERNIGHT_GAP_METAL=180
PIPELINE_OVERNIGHT_GAP_FOREX=150
PIPELINE_OVERNIGHT_GAP_CRYPTO=0

# ---------------------------------------------------------------------------
# Live fetch / ws_live
# ---------------------------------------------------------------------------
# Which instruments.py asset_type values are fetched live over WebSocket.
# Default covers 11 of 37 configured instruments; the rest (by default all
# FOREX) are historical-only, refreshed on the HISTORICAL_BACKFILL_UTC
# schedule instead of every live batch. See docs/OPERATOR_RUNBOOK.md
# section 3b before changing this - it changes both the real-time coverage
# SLA and the WebSocket session load.
LIVE_ASSET_TYPES=Indice,Metal,Crypto
# Optional drift guard: if set, live refuses to start unless the resolved
# live symbol count matches exactly. 0 = no enforcement.
EXPECTED_LIVE_SYMBOLS=0
WS_LIVE_AUTO_START=1
WS_LIVE_BATCH_INTERVAL_MIN=5
WS_LIVE_BATCH_FETCH_TIMEOUT_SEC=120
WS_LIVE_BATCH_GROUP_JOIN_TIMEOUT_SEC=135
WS_LIVE_BATCH_MAX_RETRIES=3
WS_LIVE_SHUTDOWN_POLL_SEC=2
WS_LIVE_WS_THREAD_JOIN_GRACE_SEC=10
WS_LIVE_STATE_HEARTBEAT_SEC=15
WS_LIVE_N_BARS=5
WS_LIVE_N_BARS_BACKLOG=30
WS_LIVE_MAX_MISS_RETRIES=5
WS_LIVE_MAX_BACKLOG_BATCHES=12
WS_LIVE_SYMBOLS_PER_CONN=10
WS_LIVE_RECONNECT_BASE_SEC=30
WS_LIVE_RECONNECT_MAX_SEC=300
WS_LIVE_DB_QUEUE_MAXSIZE=2000
WS_LIVE_OVERFLOW_BUFFER_MAX=500
WS_LIVE_MAX_SPOOL_ROWS=100000
WS_LIVE_SESSION_THROTTLE_SEC=0.15
WS_LIVE_STATUS_INTERVAL_SEC=3600
WS_LIVE_ETL_DIRECT_RETRIES=3
WS_LIVE_ETL_DIRECT_RETRY_DELAY_SEC=1.5
WS_LIVE_ETL_DEFERRED_RETRY_COOLDOWN_SEC=60
TV_WS_GUEST_POLICY=pause
TV_WS_GUEST_PAUSE_SEC=300
TV_WS_RATE_LIMIT_COOLDOWN_SEC=300
TV_WS_FORBIDDEN_COOLDOWN_SEC=900
TV_WS_PREFLIGHT_REQUIRE_HEADLESS=0
TV_WS_CONNECTIVITY_PREFLIGHT=1
TV_WS_CONNECTIVITY_TIMEOUT_SEC=5
TV_WS_CONNECTIVITY_COOLDOWN_SEC=300
TV_WS_TIMEZONE=Etc/UTC

# ---------------------------------------------------------------------------
# OG candle snapshot handoff over Redis
# ---------------------------------------------------------------------------
# Disabled by default. Enable only after end-to-end validation passes.
# State keys hold latest candle JSON; event stream only notifies OG what changed.
CANDLE_SNAPSHOT_ENABLED=0
OG_REDIS_HOST=10.11.12.8
OG_REDIS_PORT=6379
OG_REDIS_USERNAME=default
OG_REDIS_PASSWORD=
OG_REDIS_DB=0
CANDLE_SNAPSHOT_STATE_PREFIX=dp:candle_snapshot:latest
CANDLE_SNAPSHOT_EVENT_STREAM=dp:candle_snapshot:events
CANDLE_SNAPSHOT_EVENT_MAXLEN=10000
CANDLE_SNAPSHOT_BARS=500
CANDLE_SNAPSHOT_QUEUE_MAXSIZE=1000
CANDLE_SNAPSHOT_TIMEOUT_SEC=0.3
CANDLE_SNAPSHOT_CIRCUIT_COOLDOWN_SEC=30

# Optional realtime Pub/Sub trial lane for OG Live.
# Keep disabled until the OG subscriber is ready and end-to-end testing is planned.
DP_CANDLE_PUBSUB_ENABLED=false
DP_CANDLE_PUBSUB_CHANNEL=dp:pubsub:candle_snapshot:events
DP_CANDLE_PUBSUB_SCHEMA_VERSION=1

# ---------------------------------------------------------------------------
# Database connector
# ---------------------------------------------------------------------------
DB_RETRY_COUNT=3
DB_RETRY_DELAY_SEC=5
