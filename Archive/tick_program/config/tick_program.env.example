# SEN05 Tick Program - standalone operator config
# Copy to config/tick_program.env when running tick_program separately.

# ---------------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------------
SQL_SERVER=localhost
SQL_DATABASE=SEN05_AutoTrading
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_PORT=
SQL_TDS_VERSION=7.4
SQL_UID=
SQL_PWD=
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERT=yes
SQL_HEALTH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# cTrader / FTMO tick data
# ---------------------------------------------------------------------------
CTRADER_ENV=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_TRADER_LOGIN=
CTRADER_REDIRECT_URI=http://localhost:8765/callback
CTRADER_OAUTH_SCOPE=accounts

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Tick process (cTrader FTMO)
# ---------------------------------------------------------------------------
CTRADER_FTMO_TICK_BATCH_SIZE=500
CTRADER_FTMO_TICK_FLUSH_SECONDS=1.0
CTRADER_FTMO_TICK_MAX_QUOTE_SIDE_AGE_SECONDS=900
CTRADER_FTMO_TICK_QUEUE_MAXSIZE=50000
CTRADER_FTMO_TICK_RESPONSE_TIMEOUT_SECONDS=60
CTRADER_FTMO_TICK_RECONNECT_MIN_SECONDS=5
CTRADER_FTMO_TICK_RECONNECT_MAX_SECONDS=300
CTRADER_FTMO_TICK_STALE_SECONDS_BTC=120
CTRADER_FTMO_TICK_STALE_SECONDS_MARKET=600
CTRADER_FTMO_TICK_STALE_RESTART_SECONDS=900
CTRADER_FTMO_TICK_HEARTBEAT_LOG_SECONDS=300
CTRADER_FTMO_TICK_DISCORD_REPORT_SECONDS=3600
CTRADER_FTMO_TICK_SCHEMA=tick

# Scheduled historical backfill retry/timeout tuning.
CTRADER_FTMO_TICK_SCHEDULED_REQUEST_TIMEOUT_SECONDS=120
CTRADER_FTMO_TICK_SCHEDULED_BACKFILL_MAX_ATTEMPTS=5
CTRADER_FTMO_TICK_SCHEDULED_BACKFILL_RETRY_SLEEP_SECONDS=15
CTRADER_FTMO_TICK_SCHEDULED_BACKFILL_RETRY_SLEEP_MAX_SECONDS=180

# One-time seed when tick tables are empty.
CTRADER_FTMO_TICK_FIRST_RUN_ENABLED=1
CTRADER_FTMO_TICK_FIRST_RUN_AUTO_START=0
CTRADER_FTMO_TICK_FIRST_RUN_BACKFILL_DAYS=30

# Startup + fixed daily overlap repair. 2880 minutes = 48 hours.
CTRADER_FTMO_TICK_STARTUP_GAP_FILL_ENABLED=1
CTRADER_FTMO_TICK_GAP_FILL_LOOKBACK_MINUTES=2880
CTRADER_FTMO_TICK_GAP_FILL_DELAY_SECONDS=60
CTRADER_FTMO_TICK_GAP_FILL_NOTIFY=1

# Narrow-B repair: frequent smaller overlap between daily fills.
CTRADER_FTMO_TICK_NARROW_REPAIR_ENABLED=1
CTRADER_FTMO_TICK_NARROW_REPAIR_INTERVAL_MINUTES=60
CTRADER_FTMO_TICK_NARROW_REPAIR_LOOKBACK_MINUTES=180

# One quiet Discord health digest per UTC day.
CTRADER_FTMO_TICK_DAILY_HEALTH_SUMMARY_UTC=23:45

# Development-only switches. Keep 0 in operator deployments.
DP_USE_REPO_SOURCES=0
DP_USE_REPO_ENV=0
