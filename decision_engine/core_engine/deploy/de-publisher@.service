[Unit]
Description=core_engine publisher lane %i (strategy) - Redis DB0 SETUP + DB1 TRIGGER/CONTEXT/TREND -> per cell (symbol, strategy %i, timeframe) trend filter -> Redis DB2 signals - user service
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/administrator/Desktop/decision_engine
ExecStart=/home/administrator/Desktop/decision_engine/.venv/bin/python -m core_engine.src.main --publisher --lane %i
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
