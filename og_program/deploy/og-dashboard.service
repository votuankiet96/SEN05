[Unit]
Description=core_python dashboard - SEN05
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/Desktop/og_program
ExecStart=/home/administrator/Desktop/og_program/.venv/bin/gunicorn --bind 127.0.0.1:8516 --workers 2 --timeout 60 core_python.chart.server:create_app()
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# .env (SQL_* settings) is loaded by core_python/util/settings.py itself via
# python-dotenv, not by systemd — nothing to set here for that.

[Install]
WantedBy=multi-user.target
