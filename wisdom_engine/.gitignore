# Python cache/build artifact -- không phải nguồn, tự sinh lại khi chạy.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Virtualenv cục bộ -- tự dựng lại bằng `python3 -m venv .venv` + cài
# requirements, không thuộc mã nguồn.
.venv/
venv/

# Config THẬT chứa secret (mật khẩu SQL/Redis, webhook Discord thật) --
# KHÔNG bao giờ commit. Bản mẫu không secret: we_core/we_config.example.yaml,
# des/des_config.example.yaml
# (copy đổi tên bỏ .example rồi điền giá trị thật để chạy).
des_config.yaml
we_config.yaml

# Output vận hành, không phải mã nguồn -- we_core/deploy/runtime/exports/ là dữ liệu
# xuất CSV thật (VM-BO20 phụ thuộc qua SSHFS, không phải cache), runtime/logs/ là log
# service thật. Mỗi hệ giữ output ở deploy/runtime/ RIÊNG của nó (we_core và des). Tự
# sinh lại khi service chạy, không cần version.
/we_core/deploy/runtime/
/des/deploy/runtime/
