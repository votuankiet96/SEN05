[Unit]
Description=wes (WE Simulator) worker - Redis db14 candles -> strategy -> Redis db15 signals - user service
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/administrator/Desktop
ExecStart=/home/administrator/Desktop/wisdom_engine/.venv/bin/python -m wisdom_engine.wes.src.redis_io.live_worker
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
