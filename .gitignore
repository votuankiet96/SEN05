# Real config files contain credentials - commit only the .example templates.
config/*.env
!config/*.env.example

# Runtime output (logs, cache, PID files, ad-hoc monitor scripts, backups).
# Everything under runtime/ is transient operational output - ignore the
# whole tree and only keep directory placeholders.
runtime/**
!runtime/**/
!runtime/**/.gitkeep

# Packaging metadata from `pip install -e .`
*.egg-info/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Test artifacts (pytest temp/cache must never be committed or locked into the repo)
.pytest_cache/
.pytest_tmp*/
pytest_tmp/
tests/pytest/
.coverage

# Local executable build output
build/
dist/
*.spec

# Data exports
*.csv
*.parquet
