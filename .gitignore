# =============================================================================
# .gitignore  —  SEN 05 System - Combo
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
pytest_tmp*/
*pytest_tmp*/
logs/pytest_tmp*/
logs/pytest-tmp*/
pytest-cache-files-*/
tests/pytest/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editable install artefacts
*.pth
sen05.egg-info/

# Secrets & credentials — NEVER commit these
.env
*.env.local

# Runtime token cache (tách khỏi .env, chứa JWT/cookie ngắn hạn)
data_provider/runtime/cache/*
!data_provider/runtime/cache/.gitkeep

# SQLite durable spool (tạm thời, tự tạo lại khi start)
data_provider/runtime/spool/*
!data_provider/runtime/spool/.gitkeep

# IDE & OS artefacts
.vs/
.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
.DS_Store
desktop.ini

# Log files (runtime output, not source)
*.log
logs/*.log
logs/*.err
logs/*.out
logs/*.txt
data_provider/runtime/logs/*
!data_provider/runtime/logs/.gitkeep
data_provider/runtime/run/*
!data_provider/runtime/run/.gitkeep

# cAlgo/cTrader build and runtime output
.buildcheck/
**/bin/
**/obj/
*.csproj.lscache
cbot_calgo/cAlgo/Data/
cbot_calgo/cTrader/Journals/
ops/runtime/
watcher.pid

# Chart output HTML (generated by 03_chart.py, không phải source)
**/*_chart.html
**/combo_chart.html
**/ma_chart.html

# Jupyter checkpoints
.ipynb_checkpoints/

# Runtime-generated cache (không commit)
/cache/

# Backtest / scanner output CSV (kết quả chạy, không phải source)
output/

# Watcher runtime state - generated locally, do not commit
core_python/notify/state.json
core_python/notify/state.json.tmp
core_python/runtime/*.json
core_python/runtime/*.json.tmp
core_python/runtime/*.lock

# Signal CSV exports — runtime output, không phải source
core_python/notify/recorded_signal/**/*.csv
core_python/exports/*.csv

# Generated HTML charts (output từ ma_chart.py, combo_chart, v.v.)
*.html
# Exception: static source HTML files (not generated)
!data_provider/dashboard/chart.html
!core_python/chart/static/*.html

# Temporary lint/tool output
ruff_fix_output.txt

# Research runtime logs (.txt — không phải .log)
research/run_log.txt
research/stage2_log.txt
research/**_log.txt

# Research temporary output files (không datestamp)
strategies/combo/research/07_backtest_trades.csv
strategies/combo/research/07_backtest_chart.png

# Optimizer intermediate data (tự tạo lại khi chạy)
strategies/combo/research/02_optimizer_train.csv
strategies/combo/research/02_optimizer_test.csv

# Claude local config
**/.claude/settings.local.json
