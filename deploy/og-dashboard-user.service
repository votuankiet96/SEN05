[Unit]
Description=OG historical dashboard - user service
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/administrator/Desktop/og_program
ExecStart=/home/administrator/Desktop/og_program/.venv/bin/gunicorn --bind 127.0.0.1:8516 --workers 2 --timeout 60 og_past.chart.server:create_app()
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
