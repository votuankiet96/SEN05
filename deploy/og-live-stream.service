[Unit]
Description=OG Live Stream realtime signal generation - SEN05
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/Desktop/og_program
ExecStart=/home/administrator/Desktop/og_program/.venv/bin/python -m og_live.stream_mechanism.main
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
