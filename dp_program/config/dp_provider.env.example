# SEN05 DP Program - operator configuration.
# Copy this file to config/dp_provider.env and fill deployment values.
# Every setting below explains when an operator should change it.

# ---------------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------------
# SQL Server host name or IP. Change only when the database server moves.
SQL_SERVER=localhost
# Database that stores OHLCV data.
SQL_DATABASE=SEN05_AutoTrading
# SQL Server TCP port. Leave empty for the server/default-instance setting.
SQL_PORT=
# Leave both empty to use the Windows account running the Scheduled Task.
SQL_UID=
SQL_PWD=

# ---------------------------------------------------------------------------
# TradingView account
# ---------------------------------------------------------------------------
# Optional existing token and cookie. The program refreshes them automatically.
TV_AUTH_TOKEN=
TV_COOKIE=
# Login fallback used when cached sessions cannot recover.
TV_USERNAME=
TV_PASSWORD=
# Optional two-factor secret for automatic login recovery.
TV_2FA_SECRET=
# Existing browser profile on the DP host. Keep unchanged unless the account moves.
TV_BROWSER_PROFILE_DIR=
# Allow a completely new browser login after all saved-session recovery fails.
TV_AUTH_HEADLESS_FRESH_LOGIN=0
# Optional CAPTCHA provider and credential. Leave the key empty when unused.
TV_CAPTCHA_SERVICE=capsolver
TV_CAPTCHA_API_KEY=

# ---------------------------------------------------------------------------
# Historical schedule
# ---------------------------------------------------------------------------
# Enable automatic historical gap repair.
HISTORICAL_BACKFILL_ENABLED=1
# UTC start times in HH:MM format. UTC does not observe daylight saving time.
HISTORICAL_BACKFILL_UTC=11:00,22:00

# ---------------------------------------------------------------------------
# Discord and logs
# ---------------------------------------------------------------------------
# Discord destination for health reports and alerts.
DISCORD_WEBHOOK_URL=
# INFO is recommended. Use DEBUG only during a controlled investigation.
LOG_LEVEL=INFO
# Delete archived logs older than this many days.
LOG_RETENTION_DAYS=30
# Maximum total disk space used by active and archived logs.
LOG_DISK_BUDGET_MB=2048

# ---------------------------------------------------------------------------
# Redis destination (reserved for a reviewed OG deployment)
# ---------------------------------------------------------------------------
# These credentials are ignored while the code-level Redis feature is disabled.
OG_REDIS_HOST=
OG_REDIS_PORT=6379
OG_REDIS_USERNAME=
OG_REDIS_PASSWORD=
OG_REDIS_DB=0
