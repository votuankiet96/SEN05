[Unit]
Description=strategy_lab past-signal worker (backtest cap 2, Redis DB2 L_PastSignal + DB3 L_PastSignal_Trend)
After=network-online.target
StartLimitBurst=20
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/home/administrator/Desktop/og_program
ExecStart=/home/administrator/Desktop/og_program/.venv/bin/python -m strategy_lab.src.og_signal.redis_io.worker
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
