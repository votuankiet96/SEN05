# Python cache/build artifact -- không phải nguồn, tự sinh lại khi chạy.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Virtualenv cục bộ -- tự dựng lại bằng `python3 -m venv .venv` + cài
# requirements, không thuộc mã nguồn.
.venv/
venv/

# Config THẬT chứa secret (mật khẩu SQL/Redis, webhook Discord thật) --
# KHÔNG bao giờ commit. Bản mẫu không secret: order_gateway/og_config.
# example.yaml và strategy_lab/sl_config.example.yaml (đã push, copy đổi
# tên bỏ .example rồi điền giá trị thật để chạy).
/config.yaml
og_config.yaml
sl_config.yaml

# Output vận hành, không phải mã nguồn -- runtime/exports/ là dữ liệu
# xuất CSV thật (VM-BO20 phụ thuộc qua SSHFS, không phải cache), logs/ là
# log service thật. Cả 2 tự sinh lại khi service chạy, không cần version.
/runtime/
/research/reports/
/order_gateway/logs/
/strategy_lab/logs/
