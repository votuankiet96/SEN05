# config.yaml contains host credentials and is local-only. Cả hai dạng viết
# hoa/thường đều bị chặn: Windows không phân biệt hoa thường nên một checkout
# cũ có thể còn file tên Config.yaml, và trên Linux (core.ignorecase=false)
# một dòng duy nhất sẽ không che được dạng còn lại.
config.yaml
Config.yaml

# Runtime output (logs, cache, PID files, ad-hoc monitor scripts, backups).
# Everything under runtime/ is transient operational output - ignore the
# whole tree and only keep directory placeholders.
runtime/**
!runtime/**/
!runtime/**/.gitkeep
# Deployment evidence may contain an expanded, exact source artifact whose
# tracked-looking files must never reappear as untracked workspace changes.
runtime/deploy/**

# Packaging metadata from `pip install -e .`
*.egg-info/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Test artifacts (pytest temp/cache must never be committed or locked into the repo)
.pytest_cache/
.pytest_tmp*/
pytest_tmp/
.coverage

# Local executable build output. run_dp/*.exe is a ~50MB rebuildable
# binary (see scripts/windows/dp_program_entry.py) -- too large for git
# history. run_dp/vendor/ is the bundled Chromium build for offline
# deployment (~690MB, assembled from the local Playwright cache at
# packaging time) -- same reason. install.ps1/DEPLOY.md/sql/*.sql/
# config.example.yaml under run_dp/ ARE tracked (small, reviewable
# source, not rebuildable binary output).
build/
dist/
*.spec
run_dp/*.exe
run_dp/vendor/

# Data exports
*.csv
*.parquet

# Research probe runtime output (logs + PID files) -- the probe scripts
# themselves under research/ are tracked, their transient output is not.
research/redis_probe/probe_logs/
research/redis_probe/run/
