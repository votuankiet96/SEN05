[Unit]
Description=core_engine runner lane %i (<ten>.<nguon nen>, ten = chiến lược hoặc yếu tố trend khai ở de_config.yaml) - candles (Core AEN / OG8) -> module results in Redis DB0 (L_MODSTR_* cho chiến lược, L_MODTRE_* cho yếu tố trend) for every registered symbol and timeframe of the source - user service
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/administrator/Desktop/decision_engine
ExecStart=/home/administrator/Desktop/decision_engine/.venv/bin/python -m core_engine.src.main --runner --lane %i
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
