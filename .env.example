# SQL Server connection for OG. Copy to .env and fill in real values — see
# og_core/config.py for exactly how these are used. Never commit a real
# .env file (it's gitignored).
#
# Verified 2026-07-07 against the real DP6 SQL Server from vm-og:
# - SQL_DRIVER=freetds is what actually works on this Linux VM (only
#   FreeTDS is installed here; "ODBC Driver 18 for SQL Server" is what the
#   Windows-based production config uses, but it isn't installed on Linux
#   here — don't copy that value verbatim for a Linux deployment).
# - Windows Integrated Auth (empty SQL_UID/SQL_PWD) does NOT work from this
#   box: FreeTDS falls back to GSSAPI/Kerberos for Trusted_Connection, which
#   fails outright on a non-domain-joined Linux host. Use real SQL
#   Authentication (SQL_UID/SQL_PWD) instead on Linux.
# - If OG runs on a different host than DP6, SQL_SERVER must be DP6's real
#   address (e.g. 10.11.12.6), not "localhost" — "localhost" only works if
#   OG runs on the same machine as the SQL Server itself.
SQL_SERVER=10.11.12.6
SQL_DRIVER=freetds
SQL_PORT=1433
SQL_TDS_VERSION=7.4
SQL_UID=CHANGE_ME
SQL_PWD=CHANGE_ME
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERT=yes

# Redis connection used by og_live. The DP Program currently writes to DB 0.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# -----------------------------------------------------------------------------
# OG Live
# -----------------------------------------------------------------------------
# Stream mechanism: reads DP stream/state from db0 and publishes signal streams
# to db1.
OG_STREAM_INPUT_REDIS_DB=0
OG_STREAM_OUTPUT_REDIS_DB=1

# Stream reads trigger events, then GETs the state key carried by each event.
OG_STREAM_CANDLE_EVENT_STREAM=dp:candle_snapshot:events
OG_STREAM_CANDLE_STATE_PREFIX=dp:candle_snapshot:latest
OG_STREAM_CONSUMER_GROUP=og_live_stream
OG_STREAM_CONSUMER_NAME=og-stream-primary

# Stream mechanism watchlist.
# These filters decide which signals stream publishes after reading DP events.
# Leave OG_STREAM_SYMBOLS empty to select symbols by asset type.
# Asset aliases accepted for Indice: Indice, index, indices.
OG_STREAM_STRATEGY=combo
OG_STREAM_ASSET_TYPES=Indice
# Optional explicit symbol filter, e.g. US30,DE40. Empty = all live symbols
# matching OG_STREAM_ASSET_TYPES.
# OG_STREAM_SYMBOLS=
OG_STREAM_TIMEFRAMES=H1,H2,H3,H4
OG_STREAM_BARS=500
OG_STREAM_LATEST_ONLY=true

# Stream signal output routing.
# routed = only routed streams. legacy/dual remain supported for migration only.
OG_STREAM_SIGNAL_OUTPUT_MODE=routed
OG_STREAM_SIGNAL_STREAM_PREFIX=og:stream:signals
OG_STREAM_ROUTED_SIGNAL_STREAM_TEMPLATE=og:stream:signals:{strategy}:{symbol}:{timeframe}
OG_STREAM_SIGNAL_DEDUP_PREFIX=og:stream:dedup:signals
OG_STREAM_SIGNAL_STREAM_MAXLEN=10000
OG_STREAM_MAX_EVENT_AGE_SECONDS=900

# Pub/Sub mechanism: subscribes to the DP Pub/Sub channel and stores generated
# Pub/Sub-mechanism signal streams in db2. Redis Pub/Sub channels are not
# database-scoped; db2 is only the signal storage database.
OG_PUBSUB_ENABLED=true
OG_PUBSUB_INPUT_REDIS_DB=0
OG_PUBSUB_OUTPUT_REDIS_DB=2
OG_PUBSUB_CHANNEL=dp:pubsub:candle_snapshot:events
OG_PUBSUB_CANDLE_STATE_PREFIX=dp:candle_snapshot:latest
OG_PUBSUB_STRATEGY=combo
OG_PUBSUB_ASSET_TYPES=Indice
# OG_PUBSUB_SYMBOLS=
OG_PUBSUB_TIMEFRAMES=H1,H2,H3,H4
OG_PUBSUB_BARS=500
OG_PUBSUB_LATEST_ONLY=true
OG_PUBSUB_SIGNAL_OUTPUT_MODE=routed
OG_PUBSUB_SIGNAL_STREAM_PREFIX=og:pubsub:signals
OG_PUBSUB_ROUTED_SIGNAL_STREAM_TEMPLATE=og:pubsub:signals:{strategy}:{symbol}:{timeframe}
OG_PUBSUB_SIGNAL_DEDUP_PREFIX=og:pubsub:dedup:signals
OG_PUBSUB_SIGNAL_STREAM_MAXLEN=10000
OG_PUBSUB_MAX_EVENT_AGE_SECONDS=900
