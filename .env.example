# SQL Server connection for OG (core_python). Copy to .env and fill in real
# values — see core_python/config.py for exactly how these are used and what
# each default means. Never commit a real .env file (it's gitignored).

# Empty SQL_UID/SQL_PWD = Windows Integrated Auth (Trusted_Connection=yes),
# matching how the real SEN05_Autotrading production deployment runs.
SQL_SERVER=localhost
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_PORT=
SQL_TDS_VERSION=7.4
SQL_UID=
SQL_PWD=
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERT=yes
